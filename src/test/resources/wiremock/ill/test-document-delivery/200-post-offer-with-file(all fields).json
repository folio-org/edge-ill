{
  "request": {
    "method": "POST",
    "urlPath": "/ill/testDocumentDelivery/offer",
    "headers": {
      "X-Okapi-Tenant": {
        "equalTo": "test_tenant"
      },
      "Content-Type": {
        "contains": "multipart/form-data"
      }
    },
    "multipartPatterns": [
      {
        "name": "systemId",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "test-system-id"
          }
        ]
      },
      {
        "name": "offerReference",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "REF-001"
          }
        ]
      },
      {
        "name": "pin",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "1234"
          }
        ]
      },
      {
        "name": "documentTitle",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "Example Document Title"
          }
        ]
      },
      {
        "name": "patronEmail",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "test_patron@sample.org"
          }
        ]
      },
      {
        "name": "rawSourceMimeType",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "application/pdf"
          }
        ]
      },
      {
        "name": "workflow",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "ILL"
          }
        ]
      },
      {
        "name": "file",
        "matchingType": "ANY",
        "bodyPatterns": [
          {
            "equalTo": "fake-pdf-content"
          }
        ]
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "offerURL": "https://example.com/offer/123",
      "state": "PENDING",
      "pin": "1234",
      "workflow": "ILL",
      "message": "Test response message"
    }
  }
}
